{
  "name": "lumbre",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Entrada compatible al único LUCIAN comercial ubicado en lumbre/",
  "scripts": {
    "start": "node lumbre/server.mjs",
    "dev": "node --watch lumbre/server.mjs",
    "check": "npm --prefix lumbre run check",
    "test": "npm --prefix lumbre test",
    "test:search": "npm --prefix lumbre run test:search",
    "test:readiness": "npm --prefix lumbre run test:readiness",
    "test:core": "npm --prefix lumbre run test:core",
    "test:guards": "npm --prefix lumbre run test:guards",
    "test:flow": "npm --prefix lumbre run test:flow",
    "test:api": "npm --prefix lumbre run test:api",
    "test:verify": "npm --prefix lumbre run test:verify",
    "test:telegram": "npm --prefix lumbre run test:telegram",
    "test:scale": "npm --prefix lumbre run test:scale"
  },
  "engines": {
    "node": ">=20"
  }
}
